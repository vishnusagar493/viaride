# Server
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viaroad_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=viaroad_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=viaroad_refresh_secret_key_change_in_production

# Admin
ADMIN_EMAIL=admin@viaroad.in
ADMIN_PASSWORD=Admin@ViaRoad2024

# WhatsApp Business API
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
ADMIN_WHATSAPP_NUMBER=919867998094

# Email (nodemailer - optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Booking
TEMP_HOLD_MINUTES=30
MAX_ADVANCE_BOOKING_DAYS=90
CANCELLATION_DEDUCTION_PERCENT=10
SECURITY_DEPOSIT_AMOUNT=2000
