# Dependencies
node_modules/
frontend/node_modules/
server/node_modules/

# Build output
frontend/dist/
frontend/.vite/

# Environment files (never commit secrets)
.env
.env.local
.env.production
server/.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Uploads (user-uploaded files — stored on server, not in repo)
server/uploads/payments/
server/uploads/documents/

# Keep these upload folders but not their contents
!server/uploads/vehicles/.gitkeep
!server/uploads/qr/.gitkeep
